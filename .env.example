SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key — admin-only, used to invite new customer logins during
# onboarding. Never exposed to customer-facing code. Keep out of version
# control same as the anon key.
SUPABASE_SERVICE_ROLE_KEY=
# Blotato generation API — server-side only (Settings → API in the Blotato app).
BLOTATO_API_KEY=
# Anthropic API — powers the guardrail pipeline (§6) evaluating generated
# content before it reaches customer approval. Server-side only.
ANTHROPIC_API_KEY=
